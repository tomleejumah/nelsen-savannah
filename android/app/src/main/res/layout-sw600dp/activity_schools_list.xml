<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:background="@color/bg">

        <View
            android:id="@+id/headerWash"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/maroon_050"
            app:layout_constraintBottom_toBottomOf="@id/headerContent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/headerContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView android:id="@+id/tvScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/font_display" android:text="@string/home_enroll_schools"
                android:textColor="@color/maroon_900" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvSchoolsHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:fontFamily="@font/font_ui" android:text="@string/schools_pick_hint"
                android:textColor="@color/muted" android:textSize="13sp" />
            <LinearLayout android:id="@+id/searchBar" android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="14dp" android:background="@drawable/bg_search_field"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_search" app:tint="@color/maroon_600" />
                <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_marginStart="10dp" android:layout_weight="1" android:background="@android:color/transparent"
                    android:hint="@string/schools_search_hint" android:imeOptions="actionSearch" android:inputType="text"
                    android:maxLines="1" android:textColor="@color/ink" android:textColorHint="@color/muted" android:textSize="14sp" />
                <ImageButton android:id="@+id/btnClearSearch" android:layout_width="32dp" android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless" android:padding="6dp"
                    android:src="@drawable/ic_home_search_clear" android:visibility="gone" app:tint="@color/muted" />
            </LinearLayout>
            <TextView android:id="@+id/tvSchoolCount" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="@color/ink_soft" android:textSize="13sp" tools:text="3 schools" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshSchools" android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/headerContent">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSchools" android:layout_width="match_parent"
                android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="8dp"
                android:paddingBottom="28dp" tools:listitem="@layout/item_school_row" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <TextView android:id="@+id/tvSchoolsEmpty" android:layout_width="0dp" android:layout_height="wrap_content"
            android:gravity="center" android:padding="24dp" android:text="@string/schools_empty"
            android:textColor="@color/muted" android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/headerContent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1A000000" />

    <LinearLayout
        android:id="@+id/tabletSchoolDetail"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="visible">

        <TextView android:id="@+id/tvTabletSchoolTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/font_display" android:text="Select a school" android:textColor="@color/maroon_900"
            android:textSize="30sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvTabletSchoolHint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Choose a school on the left to browse its courses."
            android:textColor="@color/muted" android:textSize="14sp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvTabletCourses" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1"
            android:clipToPadding="false" android:paddingBottom="24dp" tools:listitem="@layout/item_course_row" />
    </LinearLayout>
</LinearLayout>