<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Light theme. Mirrors values-night/themes.xml attribute-for-attribute;
      only the token values in values(-night)/colors.xml differ.
    -->
    <style name="Base.Theme.NelsenSavannah" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/action_primary</item>
        <item name="colorOnPrimary">@color/text_on_action</item>
        <item name="colorPrimaryContainer">@color/surface_muted</item>
        <item name="colorOnPrimaryContainer">@color/text_strong</item>

        <item name="colorSecondary">@color/action_accent</item>
        <item name="colorOnSecondary">@color/text_on_action</item>

        <item name="colorAccent">@color/action_accent</item>

        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceVariant">@color/surface_muted</item>
        <item name="colorOnSurface">@color/text_strong</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorOutline">@color/outline_soft</item>
        <item name="android:colorBackground">@color/surface_app</item>

        <item name="android:textColorPrimary">@color/text_strong</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <item name="android:fontFamily">@font/font_ui</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorControlNormal">@color/maroon_700</item>
        <item name="colorControlActivated">@color/maroon_700</item>

        <!-- Selection ActionMode: maroon bar, light icons -->
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeBackground">@color/maroon_700</item>
        <item name="actionModeSplitBackground">@color/maroon_700</item>
        <item name="android:actionModeBackground">@color/maroon_700</item>
        <item name="actionModeStyle">@style/Widget.Nelsen.ActionMode</item>
    </style>

    <style name="Widget.Nelsen.ActionMode" parent="Widget.AppCompat.ActionMode">
        <item name="background">@color/maroon_700</item>
        <item name="titleTextStyle">@style/TextAppearance.Nelsen.ActionMode.Title</item>
        <item name="subtitleTextStyle">@style/TextAppearance.Nelsen.ActionMode.Title</item>
    </style>

    <style name="TextAppearance.Nelsen.ActionMode.Title" parent="TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">@color/text_on_action</item>
    </style>

    <style name="Theme.NelsenSavannah.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_branding_inset</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.NelsenSavannah</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <style name="Theme.NelsenSavannah" parent="Base.Theme.NelsenSavannah" />
</resources>
