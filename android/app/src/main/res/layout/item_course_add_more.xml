<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/ns_polaroid_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/shape_polaroid_add_more"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:minHeight="150dp"
    android:orientation="vertical"
    android:padding="20dp">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/shape_add_circle_dashed">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/font_fraunces"
            android:text="+"
            android:textColor="@color/ns_maroon"
            android:textSize="17sp" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/font_plex_mono"
        android:gravity="center"
        android:text="ENROLL IN\nMORE COURSES"
        android:textColor="@color/ns_maroon_deep"
        android:textSize="8.5sp" />
</LinearLayout>
