<?xml version="1.0" encoding="utf-8"?>
<!-- MentUI home shell: top bar → stories → courses → … Keep section order. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".MainActivity">

            <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/homeAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:visibility="gone"
            app:elevation="0dp">

            <FrameLayout
                android:id="@+id/homeTopBlur"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />
        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="0dp"
            android:scrollbars="none">

            <!-- White page for now; cream stays on tickets / polaroids / stamps. -->
            <LinearLayout
                android:id="@+id/homeSheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:elevation="0dp"
                android:orientation="vertical"
                android:paddingBottom="96dp">

                <!-- Stories: always visible; + Add pinned in adapter -->
                <LinearLayout
                    android:id="@+id/storiesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:visibility="visible">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvStories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingHorizontal="@dimen/ns_space_lg"
                        android:paddingTop="@dimen/ns_space_md"
                        android:paddingBottom="@dimen/ns_space_sm" />

                    <TextView
                        android:id="@+id/tvStoriesEmptyHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="4dp"
                        android:fontFamily="@font/font_ui"
                        android:text="@string/stories_empty_hint"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_collapseMode="parallax">

                    <SearchView
                        android:id="@+id/search_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/search_background"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:iconifiedByDefault="false"
                        android:queryHint="Search..." />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/history_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible" />
                </LinearLayout>

                <!-- Enroll Schools — school picker → courses -->
                <LinearLayout
                    android:id="@+id/cardFindMyPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/ns_space_lg"
                    android:layout_marginTop="@dimen/ns_space_md"
                    android:background="@drawable/bg_ledger_row_borders"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_fraunces"
                        android:text="@string/home_enroll_schools"
                        android:textColor="@color/ns_ink"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="8dp"
                        android:layout_marginBottom="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_divider_dashed" />

                    <TextView
                        android:id="@+id/tvFindMyPathBlurb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_plex_mono"
                        android:gravity="end"
                        android:maxWidth="140dp"
                        android:text="@string/home_browse_schools"
                        android:textColor="@color/ns_maroon"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"
                        android:text="@string/home_upcoming_schedule"
                        android:textColor="@color/ns_ink"
                        android:textSize="16sp"
                        android:fontFamily="@font/font_fraunces" />

                    <TextView
                        android:id="@+id/tvSeeMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="4dp"
                        android:text="@string/home_see_more"
                        android:textColor="@color/ns_maroon"
                        android:textSize="12sp"
                        android:fontFamily="@font/font_plex_mono"
                        android:visibility="gone" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/emptyStateView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/plusIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_add_circle"
                        app:tint="@color/ns_ink" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/font_ui"
                        android:text="@string/home_no_events"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBookMentor"
                        style="@style/Nelsen.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/home_book"
                        android:textAllCaps="false"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUpcomingEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingTop="1dp"
                    tools:itemCount="1" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <include
                        android:id="@+id/layoutCalendar"
                        layout="@layout/item_step_calendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </androidx.cardview.widget.CardView>

                <!-- Personalized enrollments; full catalog is under Find My Path / Learning -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/tvTopCoursesHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"
                        android:text="@string/home_active_courses"
                        android:textColor="@color/ns_ink"
                        android:textSize="16sp"
                        android:fontFamily="@font/font_fraunces" />

                    <TextView
                        android:id="@+id/seeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/font_plex_mono"
                        android:text="@string/home_see_all"
                        android:textColor="@color/ns_maroon"
                        android:textSize="12sp" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcCourses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/ns_space_lg"
                    android:paddingEnd="@dimen/ns_space_sm"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    tools:itemCount="5" />

                <LinearLayout
                    android:id="@+id/bannerCarousel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/bannerViewPager"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />
                </LinearLayout>

                <!-- Mentors live in-course; home rail hidden -->
                <RelativeLayout
                    android:id="@+id/mentorsSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mentors" />

                    <TextView
                        android:id="@+id/showMoreMentors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show more" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcMentorList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- Other programmes (near bottom) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:drawablePadding="6dp"
                        android:text="@string/home_other_programmes"
                        android:textColor="@color/ns_ink"
                        android:textSize="16sp"
                        android:fontFamily="@font/font_fraunces" />

                    <TextView
                        android:id="@+id/seeAllProgrammes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/font_ui"
                        android:text="@string/home_see_all"
                        android:textColor="@color/maroon_600"
                        android:textSize="14sp" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcProgrammes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/ns_space_lg"
                    android:paddingVertical="4dp"
                    tools:itemCount="3" />

                <!-- Quick actions -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/eventCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="@dimen/ns_space_lg"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/ns_cream"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/ns_line"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/btnBeMentor"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/shape_arc_stamp_circle"
                                    android:contentDescription="@null"
                                    android:padding="10dp"
                                    android:src="@drawable/ic_mentor"
                                    app:tint="@color/ns_ink" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="@string/home_qa_mentor"
                                    android:textColor="@color/ns_grey"
                                    android:textSize="8sp"
                                    android:fontFamily="@font/font_plex_mono"
                                    android:textAllCaps="true" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/btnOurShop"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/shape_arc_stamp_circle"
                                    android:contentDescription="@null"
                                    android:padding="10dp"
                                    android:src="@drawable/ic_shopping"
                                    app:tint="@color/ns_ink" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="@string/home_qa_shop"
                                    android:textColor="@color/ns_grey"
                                    android:textSize="8sp"
                                    android:fontFamily="@font/font_plex_mono"
                                    android:textAllCaps="true" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/btnRecMe"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/shape_arc_stamp_circle"
                                    android:contentDescription="@null"
                                    android:padding="10dp"
                                    android:src="@drawable/ic_who_am_i"
                                    app:tint="@color/ns_ink" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="@string/home_qa_who"
                                    android:textColor="@color/ns_grey"
                                    android:textSize="8sp"
                                    android:fontFamily="@font/font_plex_mono"
                                    android:textAllCaps="true" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/btnDonate"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/shape_arc_stamp_circle"
                                    android:contentDescription="@null"
                                    android:padding="10dp"
                                    android:src="@drawable/ic_donate"
                                    app:tint="@color/ns_ink" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="@string/home_qa_donate"
                                    android:textColor="@color/ns_grey"
                                    android:textSize="8sp"
                                    android:fontFamily="@font/font_plex_mono"
                                    android:textAllCaps="true" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

                <!-- Kept for existing findViewById callers -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Other Resources" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtRecognizeMe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="Recognize me" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/speedDial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="168dp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_date_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Group"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabCommunity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_people"
                app:backgroundTint="@color/maroon_600"
                app:fabSize="mini"
                app:tint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_date_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Story"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabStory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_add_media"
                app:backgroundTint="@color/maroon_500"
                app:fabSize="mini"
                app:tint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_date_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Event"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_add_circle"
                app:backgroundTint="@color/maroon_700"
                app:fabSize="mini"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="96dp"
        android:contentDescription="Create"
        android:src="@drawable/ic_add_circle"
        android:visibility="gone"
        app:backgroundTint="@color/maroon_700"
        app:tint="@color/white" />
</FrameLayout>
