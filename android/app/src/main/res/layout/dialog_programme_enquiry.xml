<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ns_cream"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_inter"
            android:text="@string/enquiry_as"
            android:textColor="@color/ns_ink"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/enquiryRoleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_enquiry_role_group"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/roleLearner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enquiry_role_chip"
                    android:fontFamily="@font/font_fraunces"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/enquiry_role_learner"
                    android:textColor="@color/ns_cream"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/roleCampus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enquiry_role_chip"
                    android:fontFamily="@font/font_fraunces"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/enquiry_role_campus"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/rolePartner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enquiry_role_chip"
                    android:fontFamily="@font/font_fraunces"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/enquiry_role_partner"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/roleCareers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enquiry_role_chip"
                    android:fontFamily="@font/font_fraunces"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/enquiry_role_careers"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/roleFacilitator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enquiry_role_chip"
                    android:fontFamily="@font/font_fraunces"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/enquiry_role_facilitator"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_inter"
                    android:text="@string/enquiry_full_name"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/enquiryName"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_enquiry_field"
                    android:fontFamily="@font/font_inter"
                    android:hint="@string/enquiry_name_hint"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ns_ink"
                    android:textColorHint="@color/ns_grey"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_inter"
                    android:text="@string/enquiry_email"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/enquiryEmail"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_enquiry_field"
                    android:fontFamily="@font/font_inter"
                    android:hint="@string/enquiry_email_hint"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ns_ink"
                    android:textColorHint="@color/ns_grey"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_inter"
                    android:text="@string/enquiry_phone"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/enquiryPhone"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_enquiry_field"
                    android:fontFamily="@font/font_inter"
                    android:hint="@string/enquiry_phone_hint"
                    android:inputType="phone"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ns_ink"
                    android:textColorHint="@color/ns_grey"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_inter"
                    android:text="@string/enquiry_programme"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/enquiryProgramme"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_enquiry_field"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/font_inter"
            android:text="@string/enquiry_message_label"
            android:textColor="@color/ns_ink"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/enquiryMessage"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_enquiry_field"
            android:fontFamily="@font/font_inter"
            android:gravity="top|start"
            android:hint="@string/enquiry_message_hint"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/ns_ink"
            android:textColorHint="@color/ns_grey"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/enquirySend"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_enquiry_send"
            android:fontFamily="@font/font_fraunces"
            android:gravity="center"
            android:text="@string/enquiry_send"
            android:textColor="@color/ns_cream"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/font_inter"
            android:gravity="center"
            android:text="@string/enquiry_or_email"
            android:textColor="@color/ns_ink"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
