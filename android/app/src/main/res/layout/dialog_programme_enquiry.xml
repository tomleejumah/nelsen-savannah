<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ns_cream"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_inter"
            android:text="I am enquiring as"
            android:textColor="@color/ns_ink"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/enquiryRoleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_enquiry_role_group"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/roleLearner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enquiry_role_chip"
                    android:fontFamily="@font/font_fraunces"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:selected="true"
                    android:text="Join programme"
                    android:textColor="@color/ns_cream"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/roleCampus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enquiry_role_chip"
                    android:fontFamily="@font/font_fraunces"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:text="Host on campus"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/rolePartner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enquiry_role_chip"
                    android:fontFamily="@font/font_fraunces"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:text="Partner"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/roleCareers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enquiry_role_chip"
                    android:fontFamily="@font/font_fraunces"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:text="Work with us"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/roleFacilitator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enquiry_role_chip"
                    android:fontFamily="@font/font_fraunces"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:text="Facilitator"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_inter"
                    android:text="Full name"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/enquiryName"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_enquiry_field"
                    android:fontFamily="@font/font_inter"
                    android:hint="Your full name"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ns_ink"
                    android:textColorHint="@color/ns_grey"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_inter"
                    android:text="Email"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/enquiryEmail"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_enquiry_field"
                    android:fontFamily="@font/font_inter"
                    android:hint="you@email.com"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ns_ink"
                    android:textColorHint="@color/ns_grey"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_inter"
                    android:text="Phone (optional)"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/enquiryPhone"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_enquiry_field"
                    android:fontFamily="@font/font_inter"
                    android:hint="+254 7…"
                    android:inputType="phone"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ns_ink"
                    android:textColorHint="@color/ns_grey"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_inter"
                    android:text="Programme of interest"
                    android:textColor="@color/ns_ink"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/enquiryProgramme"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_enquiry_field"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/font_inter"
            android:text="What would you like to know?"
            android:textColor="@color/ns_ink"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/enquiryMessage"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_enquiry_field"
            android:fontFamily="@font/font_inter"
            android:gravity="top|start"
            android:hint="Your background, preferred intake, and what you hope to build or learn."
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/ns_ink"
            android:textColorHint="@color/ns_grey"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/enquirySend"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_enquiry_send"
            android:fontFamily="@font/font_fraunces"
            android:gravity="center"
            android:text="Send message"
            android:textColor="@color/ns_cream"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/font_inter"
            android:gravity="center"
            android:text="Or email hello@nelsen-savannah.co.ke"
            android:textColor="@color/ns_ink"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
