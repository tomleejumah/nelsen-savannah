<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/livePreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#77000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tvLiveTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_display"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLiveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Preparing camera…"
            android:textColor="#E0E0E0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLiveViewers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0 watching"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/hostChatScroll"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:fadeScrollbars="true">

            <TextView
                android:id="@+id/tvLiveChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waiting for viewers…"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:padding="8dp"
                android:background="#88000000" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputHostLiveChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Message viewers"
                android:singleLine="true"
                android:maxLength="500"
                android:textColor="#FFFFFF"
                android:textColorHint="#CCCCCC"
                android:inputType="textCapSentences" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHostSendLiveChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleMic"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Mute microphone"
                    android:text=""
                    app:icon="@drawable/ic_live_mic"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="#FFFFFF"
                    app:strokeColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleCamera"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Turn camera off"
                    android:text=""
                    app:icon="@drawable/ic_live_camera"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="#FFFFFF"
                    app:strokeColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitchCamera"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Flip camera"
                    android:text=""
                    app:icon="@drawable/ic_live_flip"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="#FFFFFF"
                    app:strokeColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareScreen"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Share screen"
                    android:text=""
                    app:icon="@drawable/ic_live_screen_share"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="#FFFFFF"
                    app:strokeColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareLive"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Share live"
                    android:text=""
                    app:icon="@drawable/ic_live_share"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="#FFFFFF"
                    app:strokeColor="#FFFFFF" />
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEndLive"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#D32F2F"
            android:text="End live"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_live_end"
            app:iconTint="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
