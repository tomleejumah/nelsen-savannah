<?xml version="1.0" encoding="utf-8"?>
<!-- Group row — cream ledger slip with stamp logo (keep CommunityAdapter IDs). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_journal_slip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shape_arc_stamp_circle">

            <ImageView
                android:id="@+id/imgCommunityLogo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:padding="1dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCommunityName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/font_fraunces"
                android:maxLines="1"
                android:textColor="@color/ns_ink"
                android:textSize="15sp"
                tools:text="Trailblazers circle" />

            <TextView
                android:id="@+id/tvCommunityDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/font_inter"
                android:maxLines="2"
                android:textColor="@color/ns_grey"
                android:textSize="12sp"
                tools:text="Ask questions and share wins with mentors." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.zen.overlapimagelistview.OverlapImageListView
                    android:id="@+id/overlapImage"
                    android:layout_width="48dp"
                    android:layout_height="26dp"
                    android:visibility="gone"
                    app:circleCount="3"
                    app:fillColor="@color/ns_paper_2"
                    app:strokeColor="@color/ns_cream"
                    app:strokeWidth="2dp" />

                <TextView
                    android:id="@+id/tvCommunityMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/font_plex_mono"
                    android:textAllCaps="true"
                    android:textColor="@color/ns_maroon"
                    android:textSize="10sp"
                    tools:text="12 members" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
