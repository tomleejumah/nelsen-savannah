<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp"><Spinner android:id="@+id/ideLanguage" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"/><com.google.android.material.button.MaterialButton android:id="@+id/ideReset" style="@style/Nelsen.Button.Secondary" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Reset" android:textAllCaps="false"/><com.google.android.material.button.MaterialButton android:id="@+id/ideRun" style="@style/Nelsen.Button.Primary" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="Run" android:textAllCaps="false"/><ProgressBar android:id="@+id/ideRunProgress" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp" android:visibility="gone"/></LinearLayout>
<io.github.rosemoe.sora.widget.CodeEditor android:id="@+id/ideEditor" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
<EditText android:id="@+id/ideStdin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:hint="stdin (optional)" android:inputType="textMultiLine" android:maxLines="3" android:textColor="@color/ink" android:textColorHint="@color/muted"/>
<TextView android:id="@+id/ideOutput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:background="@color/surface_2" android:fontFamily="monospace" android:maxHeight="180dp" android:padding="12dp" android:textColor="@color/ink" android:textIsSelectable="true" android:visibility="gone"/></LinearLayout>