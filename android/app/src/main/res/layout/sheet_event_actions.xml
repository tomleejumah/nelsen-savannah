<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/semibold"
        android:text="Event"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/btnPrimaryAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/info_card_bg"
        android:backgroundTint="?attr/colorPrimary"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/btnPrimaryActionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add to Google Calendar"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnAddCalendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/info_card_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/btnAddCalendarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add to Google Calendar"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnDeleteEvent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/info_card_bg"
        android:backgroundTint="#FCE8E6"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnDeleteEventText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete event"
            android:textColor="@color/maroon_600"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
