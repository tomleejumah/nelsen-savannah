<?xml version="1.0" encoding="utf-8"?>
<!-- Field Journal polaroid course card — keep MentUI view IDs for CoursesAdapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/eventCard"
    android:layout_width="@dimen/ns_polaroid_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/shape_polaroid_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="6dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ns_polaroid_photo_height"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/iv_course_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ns_paper_2"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/likeBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="5dp"
            android:background="#4D000000"
            android:padding="6dp"
            android:src="@drawable/ic_like" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/courseBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="2dp">

        <TextView
            android:id="@+id/tv_course_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/font_fraunces"
            android:maxLines="2"
            android:textColor="@color/ns_ink"
            android:textSize="12.5sp"
            android:textStyle="italic"
            tools:text="Foundations of Public Speaking" />

        <!-- Tutor + lessons as one meta line (avatar kept for profile tap). -->
        <LinearLayout
            android:id="@+id/tutorClickRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_tutor_avatar"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_tutor_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/font_plex_mono"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/ns_grey"
                android:textSize="8sp"
                tools:text="GRACE ACHIENG" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_plex_mono"
                android:textColor="@color/ns_grey"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/tv_lessons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_plex_mono"
                android:textColor="@color/ns_grey"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
