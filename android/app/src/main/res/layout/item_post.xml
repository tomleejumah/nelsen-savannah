<?xml version="1.0" encoding="utf-8"?>
<!-- Reddit-style post row. Keep CommunityPostAdapter IDs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tvPostVotes"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:drawablePadding="2dp"
        android:fontFamily="@font/font_inter"
        android:gravity="center_horizontal"
        android:textColor="@color/ns_ink"
        android:textSize="12sp"
        android:textStyle="bold"
        app:drawableTint="@color/ns_maroon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPostMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_inter"
            android:textColor="@color/ns_grey"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPostTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/font_inter"
            android:textColor="@color/ns_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPostBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/font_inter"
            android:maxLines="3"
            android:textColor="@color/ns_grey"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivPostImage"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPostComments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="4dp"
            android:fontFamily="@font/font_inter"
            android:gravity="center_vertical"
            android:textColor="@color/ns_grey"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_chat"
            app:drawableTint="@color/ns_grey" />
    </LinearLayout>
</LinearLayout>
