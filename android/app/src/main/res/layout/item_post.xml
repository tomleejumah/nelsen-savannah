<?xml version="1.0" encoding="utf-8"?>
<!-- Opened-group post card: community header, title, body, media, vote/comment/share. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_post_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPostCommunity"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Nelsen.Circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPostCommunity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/font_ui"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Nairobi Devs" />

            <TextView
                android:id="@+id/tvPostMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_ui"
                android:textColor="@color/muted"
                android:textSize="12sp"
                tools:text="mwangi · 6h" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnPostJoined"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_muted"
            android:fontFamily="@font/font_ui"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingHorizontal="12dp"
            android:text="Joined"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPostTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/font_ui"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="Saturday meetup" />

    <TextView
        android:id="@+id/tvPostBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/font_ui"
        android:maxLines="4"
        android:textColor="@color/muted"
        android:textSize="14sp"
        tools:text="Free entry, pizza included." />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivPostImage"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Nelsen.Rounded12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/voteBar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_muted"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/btnUpvote"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_like"
                app:tint="@color/ink" />

            <TextView
                android:id="@+id/tvPostVotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:fontFamily="@font/font_ui"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="388" />

            <ImageView
                android:id="@+id/btnDownvote"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:rotation="180"
                android:src="@drawable/ic_like"
                app:tint="@color/muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/commentBar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_muted"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chat"
                app:tint="@color/ink" />

            <TextView
                android:id="@+id/tvPostComments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/font_ui"
                android:textColor="@color/ink"
                android:textSize="13sp"
                tools:text="57" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnSharePost"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_muted"
            android:contentDescription="@string/share"
            android:padding="8dp"
            android:src="@drawable/ic_share"
            app:tint="@color/ink" />
    </LinearLayout>
</LinearLayout>
