<?xml version="1.0" encoding="utf-8"?>
<!-- Field Journal programme row — keep ProgrammesAdapter IDs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row_bottom_divider"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <View
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/dot_notification_indicator" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAudienceTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvProgramIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvProgramTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_fraunces"
            android:textColor="@color/ns_ink"
            android:textSize="14sp"
            tools:text="Rural Youth Fellowship" />

        <TextView
            android:id="@+id/tvProgramBlurb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/font_inter"
            android:maxLines="2"
            android:textColor="@color/ns_grey"
            android:textSize="11.5sp"
            tools:text="12-week mentorship for students outside major towns." />

        <LinearLayout
            android:id="@+id/checklistContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvApply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/font_plex_mono"
        android:text="@string/home_apply"
        android:textColor="@color/ns_maroon"
        android:textSize="10sp" />
</LinearLayout>
