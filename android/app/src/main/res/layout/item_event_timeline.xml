<?xml version="1.0" encoding="utf-8"?>
<!-- Field Journal ticket — keep EventAdapter IDs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ns_space_lg"
    android:layout_marginBottom="@dimen/ns_space_sm"
    android:clipChildren="false">

    <com.github.vipulasri.timelineview.TimelineView
        android:id="@+id/itemDottedLine"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/dottedLine"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/timelineDot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/eventCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:rotation="-0.6"
        app:cardBackgroundColor="@color/ns_cream"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/ns_ink"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvFormatTag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/font_plex_mono"
                    android:textAllCaps="true"
                    android:textColor="@color/ns_grey"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvEventDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_plex_mono"
                    android:textAllCaps="true"
                    android:textColor="@color/ns_grey"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvProgramTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/seatsBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSeatsLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_plex_mono"
                        android:textColor="@color/ns_grey"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvSeatsPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/seatsProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/font_fraunces"
                android:maxLines="2"
                android:textColor="@color/ns_ink"
                android:textSize="16.5sp" />

            <TextView
                android:id="@+id/tvEventDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEventTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/font_plex_mono"
                android:textColor="@color/ns_grey"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvEventPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/font_plex_mono"
                android:maxLines="1"
                android:textColor="@color/ns_grey"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvEventPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEventBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/font_plex_mono"
                    android:text="admit one mentee"
                    android:textColor="@color/ns_grey"
                    android:textSize="8.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReserve"
                    style="@style/Widget.Material3.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="@color/ns_maroon"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="Reserve"
                    android:textAllCaps="false"
                    android:textColor="@color/ns_cream"
                    android:textSize="10.5sp"
                    app:cornerRadius="0dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View
        android:layout_width="@dimen/ns_ticket_notch"
        android:layout_height="@dimen/ns_ticket_notch"
        android:layout_gravity="center_vertical|start"
        android:background="@drawable/shape_notch_circle"
        android:translationX="-7dp" />

    <View
        android:layout_width="@dimen/ns_ticket_notch"
        android:layout_height="@dimen/ns_ticket_notch"
        android:layout_gravity="center_vertical|end"
        android:background="@drawable/shape_notch_circle"
        android:translationX="7dp" />
</FrameLayout>
