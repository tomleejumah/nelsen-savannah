<?xml version="1.0" encoding="utf-8"?>
<!-- Cream slip with thin ink border — chats / notifications / group cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ns_cream" />
    <stroke
        android:width="1dp"
        android:color="@color/ns_ink" />
    <corners android:radius="2dp" />
</shape>
