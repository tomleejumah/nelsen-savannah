// DRAFT — NOT DEPLOYED. Diff against the rules currently live in the Firebase
// console before using. Rules are externally managed today; this file exists so
// they can be reviewed and versioned. Keep the `list` rule exactly as below:
// going through isParticipant() makes every list query fail with PERMISSION_DENIED.
//
// Deploy (only after review): firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isMember(room) {
      return room.userIds is list && request.auth.uid in room.userIds;
    }
    function isRoomAdmin(room) {
      return room.adminIds is list && request.auth.uid in room.adminIds;
    }
    // Rooms where only admins may post: school announcements / system rooms.
    function adminOnlyPosting(room) {
      return room.type == 'system' && room.get('schoolId', '') != '';
    }

    match /chatRooms/{roomId} {
      // Queries must constrain on userIds (array-contains) to satisfy this.
      allow list: if signedIn() && request.auth.uid in resource.data.userIds;
      // Direct get also allowed for a not-yet-created room so the client can
      // check existence before create (avoids PERMISSION_DENIED on nonexistent doc).
      allow get: if signedIn() && (resource == null || isMember(resource.data));
      // Direct rooms are created by a participant including themselves.
      allow create: if signedIn()
        && request.resource.data.userIds is list
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.type in ['direct', 'ai'];
      // Group / school rooms are created and membership-synced by the API (Admin SDK).
      allow update: if signedIn() && isMember(resource.data)
        && request.resource.data.userIds == resource.data.userIds
        && request.resource.data.adminIds == resource.data.get('adminIds', []);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && isMember(get(/databases/$(database)/documents/chatRooms/$(roomId)).data);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && isMember(get(/databases/$(database)/documents/chatRooms/$(roomId)).data)
          && (!adminOnlyPosting(get(/databases/$(database)/documents/chatRooms/$(roomId)).data)
              || isRoomAdmin(get(/databases/$(database)/documents/chatRooms/$(roomId)).data));
        // Only the sender may edit/soft-delete their own message.
        allow update: if signedIn() && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == request.auth.uid;
        allow delete: if false;
      }
    }

    // Written only by the API (Admin SDK bypasses rules).
    match /chatNotificationClaims/{id} { allow read, write: if false; }
  }
}
