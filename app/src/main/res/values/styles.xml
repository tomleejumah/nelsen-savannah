<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeOverlay.Material3.MaterialAlertDialog.Fullscreen" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="CalendarDot">
        <item name="android:layout_width">4dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/calendar_dot</item>
    </style>
    <style name="FontMedium">
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="SoundProgressBarVertical">
        <item name="android:focusable">false</item>
        <item name="android:maxWidth">6dp</item>
        <item name="android:indeterminateOnly">false</item>
        <item name="android:indeterminateDrawable">@drawable/sound_progress</item>
        <item name="android:progressDrawable">@drawable/sound_progress</item>
        <item name="android:minWidth">6dp</item>
        <item name="android:thumb">@null</item>
    </style>

    <!-- MentUI typography -->
    <style name="TextAppearance.Nelsen.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/font_display</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Nelsen.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/font_ui</item>
        <item name="android:textColor">@color/ink_soft</item>
    </style>

    <style name="TextAppearance.Nelsen.Muted" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/font_ui</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="TextAppearance.Nelsen.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/font_ui</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
    </style>

    <!-- MentUI buttons -->
    <style name="Nelsen" />
    <style name="Nelsen.Button" />
    <style name="Nelsen.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_on_action</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/font_ui</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <style name="Nelsen.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="backgroundTint">@null</item>
        <item name="strokeColor">@color/maroon_700</item>
        <item name="android:textColor">@color/maroon_700</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/font_ui</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <style name="Nelsen.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/font_ui</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <!-- MentUI tags -->
    <style name="Nelsen.Tag" />
    <style name="Nelsen.Tag.Maroon" parent="@android:style/Widget.TextView">
        <item name="android:background">@drawable/bg_tag_maroon</item>
        <item name="android:textColor">@color/maroon_600</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/font_ui</item>
    </style>

    <style name="Nelsen.Tag.Blue" parent="@android:style/Widget.TextView">
        <item name="android:background">@drawable/bg_tag_blue</item>
        <item name="android:textColor">@color/tag_blue_text</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/font_ui</item>
    </style>
</resources>
