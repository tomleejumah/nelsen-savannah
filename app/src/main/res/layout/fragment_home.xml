<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/top1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="15dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:paddingTop="5dp"
                android:paddingEnd="20dp"
                android:text="Greatness Begins "

                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="RtlSymmetry" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_pill"
                android:fontFamily="@font/poppins_regular"
                android:paddingEnd="20dp"
                android:paddingBottom="5dp"
                android:text="with  guidance"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        
        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_notifications" />
        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_marginStart="4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/donation" />

    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:visibility="gone"
        android:id="@+id/top2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/top1"
        android:layout_marginHorizontal="15dp"
        app:cardCornerRadius="36dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgPostq"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:contentDescription="@string/todo"
                android:scaleType="centerCrop"
                android:src="@drawable/donation"
                app:layout_constraintDimensionRatio="1:1.2"
                tools:ignore="MissingConstraints" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#30000000" />

        <TextView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Donation"
            android:layout_margin="10dp"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#CCCCCC" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_margin="15dp"
            android:layout_gravity="end|bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <!--            -->

            <TextView
                android:id="@+id/txt1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txt2"
                android:fontFamily="@font/poppins_regular"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Donation Does Not"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txt2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/donateNow"
                android:fontFamily="@font/poppins_regular"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Decrease Wealth"
                android:textColor="@android:color/white"
                android:textSize="18sp" />


            <com.zen.overlapimagelistview.OverlapImageListView
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@+id/txt2"
                android:id="@+id/overlapImage"
                android:layout_width="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_height="28dp"
                app:circleCount="3"
                app:fillColor="#000000"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="4dp"
                tools:ignore="MissingConstraints" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@+id/overlapImage"
                app:layout_constraintBottom_toBottomOf="parent"
                android:fontFamily="@font/poppins_regular"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/txt2"
                android:layout_marginStart="5dp"
                android:textColor="@color/background_color_light"
                android:text="And More"/>

            <androidx.appcompat.widget.AppCompatButton
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:id="@+id/donateNow"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_regular"
                android:background="@drawable/btn_login_bg"
                android:backgroundTint="#649FCE"
                android:text="Donate"
                android:textAllCaps="false" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>


</LinearLayout>
