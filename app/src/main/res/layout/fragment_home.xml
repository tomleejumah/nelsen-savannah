<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" tools:context=".MainActivity">
    <com.google.android.material.appbar.AppBarLayout android:background="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:id="@+id/top1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="4dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_regular" android:paddingEnd="20dp" android:text="Greatness Begins " android:textColor="#000000" android:textSize="18sp" android:textStyle="bold"/>
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/gradient_pill" android:fontFamily="@font/poppins_regular" android:paddingEnd="20dp" android:paddingBottom="5dp" android:text="with  guidance" android:textColor="#000000" android:textSize="18sp" android:textStyle="bold"/>
        </LinearLayout>
        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:padding="8dp">
          <ImageView android:id="@+id/imgNotification" android:layout_width="32dp" android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:srcCompat="@drawable/ic_notifications"/>
          <TextView android:id="@+id/notifCounter" android:layout_width="18dp" android:layout_height="22dp" android:layout_marginBottom="18dp" android:background="@drawable/circle" android:clickable="true" android:focusable="true" android:text="0" android:textAlignment="center" android:textColor="@color/black" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="@+id/imgNotification" app:layout_constraintEnd_toEndOf="@+id/imgNotification" app:layout_constraintHorizontal_bias="0.963" app:layout_constraintStart_toStartOf="@+id/imgNotification" app:layout_constraintTop_toTopOf="@+id/imgNotification"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <de.hdodenhof.circleimageview.CircleImageView android:id="@+id/imgDp" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:padding="8dp" android:src="@drawable/ic_person"/>
      </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <ScrollView android:id="@+id/scrollView" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/storiesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
          <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvStories" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:paddingHorizontal="6dp" android:paddingVertical="8dp"/>
          <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" app:layout_collapseMode="parallax">
          <SearchView android:id="@+id/search_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:background="@drawable/search_background" android:focusable="true" android:focusableInTouchMode="true" android:iconifiedByDefault="false" android:queryHint="Search..."/>
          <androidx.recyclerview.widget.RecyclerView android:id="@+id/history_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="visible"/>
        </LinearLayout>
        <!--//courses-->
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:fontFamily="@font/poppins_bold" android:padding="2dp" android:text="Top Courses" android:textAlignment="center" android:textSize="19sp" android:textStyle="bold"/>
          <TextView android:id="@+id/seeAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_marginEnd="18dp" android:fontFamily="@font/poppins_regular" android:text="See All" android:textAlignment="center"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView tools:itemCount="5" android:id="@+id/rcCourses" android:layout_width="match_parent" android:layout_height="wrap_content" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent" app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
          <androidx.viewpager2.widget.ViewPager2 android:id="@+id/bannerViewPager" android:layout_width="match_parent" android:layout_height="200dp"/>
        </LinearLayout>
        <TextView android:layout_margin="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:text="Your Calendar Schedules &gt;" android:textStyle="bold" android:fontFamily="@font/poppins_bold" android:drawableEnd="@drawable/back"/>
        <LinearLayout android:visibility="gone" android:id="@+id/emptyStateView" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="48dp">
          <!-- Icon Container -->
          <FrameLayout android:layout_width="120dp" android:layout_height="120dp" android:layout_marginBottom="24dp">
            <!-- Circle Background -->
            <View android:id="@+id/circleBackground" android:layout_width="120dp" android:layout_height="120dp" android:background="@drawable/empty_state_circle"/>
            <!-- Calendar Icon -->
            <LinearLayout android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="center" android:background="@drawable/calendar_bg" android:orientation="vertical" android:elevation="4dp">
              <!-- Calendar Header -->
              <View android:layout_width="match_parent" android:layout_height="15dp" android:background="@color/light_blue_900"/>
              <!-- Calendar Dots -->
              <GridLayout android:layout_width="match_parent" android:layout_height="match_parent" android:columnCount="3" android:rowCount="3" android:padding="8dp" android:alignmentMode="alignMargins">
                <View style="@style/CalendarDot"/>
                <View style="@style/CalendarDot"/>
                <View style="@style/CalendarDot"/>
                <View style="@style/CalendarDot"/>
                <View style="@style/CalendarDot"/>
                <View style="@style/CalendarDot"/>
              </GridLayout>
            </LinearLayout>
            <!-- Plus Icon -->
            <ImageView android:id="@+id/plusIcon" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="bottom|end" android:layout_marginEnd="-0dp" android:layout_marginBottom="-3dp" android:src="@drawable/ic_add_circle" android:elevation="6dp" app:tint="#4CAF50"/>
          </FrameLayout>
          <!-- Title -->
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No Events Yet" android:textSize="24sp" android:textColor="#212121" android:textStyle="bold" android:layout_marginBottom="12dp"/>
          <!-- Description -->
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="You don't have any upcoming events scheduled.\nStart by booking a mentor session." android:textSize="12sp" android:textColor="#757575" android:gravity="center" android:lineSpacingMultiplier="1.4" android:layout_marginBottom="24dp"/>
          <!-- CTA Button -->
          <com.google.android.material.button.MaterialButton android:id="@+id/btnBookMentor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Book a Mentor" android:backgroundTint="@color/purple_700" android:textSize="15sp" android:paddingStart="32dp" android:paddingEnd="32dp" app:cornerRadius="8dp"/>
        </LinearLayout>
        <TextView android:visibility="gone" android:id="@+id/tvSeeMore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/rounded_button" android:drawablePadding="8dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="See More" android:textColor="@color/black" android:layout_gravity="center_horizontal" android:textSize="16sp" android:gravity="center_vertical" app:drawableStartCompat="@drawable/ic_down_circle"/>
        <!-- Show 3 events -->
        <androidx.recyclerview.widget.RecyclerView tools:itemCount="3" android:id="@+id/rvUpcomingEvents" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:visibility="gone" app:cardCornerRadius="16dp" app:cardElevation="4dp">
          <include android:id="@+id/layoutCalendar" layout="@layout/item_step_calendar" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </androidx.cardview.widget.CardView>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="6dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:fontFamily="@font/poppins_bold" android:padding="4dp" android:text="Mentors" android:textAlignment="center" android:textSize="19sp" android:textStyle="bold"/>
          <TextView android:id="@+id/ShowALl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_marginEnd="18dp" android:padding="4dp" android:text="Show More" android:textAlignment="center"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView android:layout_marginBottom="00dp" android:nestedScrollingEnabled="false" tools:itemCount="3" android:id="@+id/rcMentorList" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/eventCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_marginStart="8dp" android:layout_marginVertical="4dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#FAFAFA" app:cardElevation="0dp" app:strokeWidth="0dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <!-- Action Buttons -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="24dp" android:gravity="center">
              <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageView android:id="@+id/btnBeMentor" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_mentor" android:background="@drawable/item_background_selectable" android:clickable="true" android:focusable="true" android:contentDescription="Deposit"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Be a \n Mentor" android:layout_gravity="center" android:gravity="center" android:textSize="12sp" android:textColor="#000000" android:layout_marginTop="8dp"/>
              </LinearLayout>
              <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageView android:id="@+id/btnOurShop" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_shopping" android:background="@drawable/item_background_selectable" android:clickable="true" android:focusable="true" android:contentDescription="Deposit"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="our \n Shop" android:gravity="center" android:textSize="12sp" android:textColor="#000000" android:layout_marginTop="8dp"/>
              </LinearLayout>
              <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                <ImageView android:id="@+id/btnRecMe" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_who_am_i" android:background="@drawable/item_background_selectable" android:clickable="true" android:focusable="true" android:contentDescription="Deposit"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Who \n I'm I" android:gravity="center" android:textSize="12sp" android:textColor="#000000" android:layout_marginTop="8dp"/>
              </LinearLayout>
              <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                <ImageView android:id="@+id/btnDonate" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_donate" android:background="@drawable/item_background_selectable" android:clickable="true" android:focusable="true" android:contentDescription="Deposit"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Donate \n to Us" android:gravity="center" android:textSize="12sp" android:textColor="#000000" android:layout_marginTop="8dp"/>
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <Space android:layout_width="match_parent" android:layout_height="70dp"/>
        <RelativeLayout android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="6dp" android:padding="12dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:fontFamily="@font/poppins_bold" android:text="Other Resources" android:textAlignment="center" android:textSize="19sp" android:textStyle="bold"/>
        </RelativeLayout>
        <LinearLayout android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="50dp" android:orientation="vertical">
          <TextView android:id="@+id/txtRecorgnizeMe" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:maxLines="3" android:padding="10dp" android:text="Recorgnize me" android:textStyle="bold" app:drawableEndCompat="@drawable/ic_more"/>
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:maxLines="3" android:padding="10dp" android:text="Our Online Store" android:textStyle="bold" app:drawableEndCompat="@drawable/ic_more"/>
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:maxLines="3" android:padding="10dp" android:text="Donate to Us" android:textStyle="bold" app:drawableEndCompat="@drawable/ic_more"/>
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
  </LinearLayout>
  <!-- Expandable "Create" speed dial (mentors only) -->
  <LinearLayout android:id="@+id/speedDial" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_marginEnd="22dp" android:layout_marginBottom="168dp" android:gravity="end" android:orientation="vertical" android:visibility="gone">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:background="@drawable/bg_date_chip" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Community" android:textColor="?attr/colorOnSurface" android:textSize="13sp"/>
      <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabCommunity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/ic_people" app:backgroundTint="#0EA5E9" app:fabSize="mini" app:tint="#FFFFFF"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:background="@drawable/bg_date_chip" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Story" android:textColor="?attr/colorOnSurface" android:textSize="13sp"/>
      <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabStory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/ic_add_media" app:backgroundTint="#DB2777" app:fabSize="mini" app:tint="#FFFFFF"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:background="@drawable/bg_date_chip" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Event" android:textColor="?attr/colorOnSurface" android:textSize="13sp"/>
      <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabEvent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/ic_add_circle" app:backgroundTint="#059669" app:fabSize="mini" app:tint="#FFFFFF"/>
    </LinearLayout>
  </LinearLayout>
  <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabCreateMain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_marginEnd="20dp" android:layout_marginBottom="96dp" android:contentDescription="Create" android:src="@drawable/ic_add_circle" android:visibility="gone" app:backgroundTint="?attr/colorPrimary" app:tint="#FFFFFF"/>
</FrameLayout>

