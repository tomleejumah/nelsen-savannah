<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="10dp"
    android:checkable="false"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#ECECEC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/story_ring_bg"
            android:padding="3dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_people"
                app:tint="#4F46E5" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCommunityName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Community"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCommunityDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/memberAvatars"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/avatar1"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="#EEF0FF"
                        android:padding="4dp"
                        android:src="@drawable/ic_person"
                        app:civ_border_color="#FFFFFF"
                        app:civ_border_width="1.5dp" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/avatar2"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="17dp"
                        android:background="#E0E7FF"
                        android:padding="4dp"
                        android:src="@drawable/ic_person"
                        app:civ_border_color="#FFFFFF"
                        app:civ_border_width="1.5dp" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/avatar3"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="34dp"
                        android:background="#C7D2FE"
                        android:padding="4dp"
                        android:src="@drawable/ic_person"
                        app:civ_border_color="#FFFFFF"
                        app:civ_border_width="1.5dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvCommunityMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="#4F46E5"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
