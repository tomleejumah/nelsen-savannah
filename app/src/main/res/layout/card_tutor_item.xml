<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Left - Profile Image -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_tutor_profile"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/donation"
            app:civ_border_width="1dp"
            app:civ_border_color="@color/light_black" />

        <!-- Middle - Tutor Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <!-- Name and Rate Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/tv_tutor_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sarah Johnson"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                <ImageButton
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_badge_verified"
                    android:backgroundTint="@color/white"/>

            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/tv_tutor_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Experienced tutor specializing in Front-End Web/Mobile Development."
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Students Count -->
                <com.zen.overlapimagelistview.OverlapImageListView
                    android:id="@+id/overlapImage"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:circleCount="3"
                    app:fillColor="#000000"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="4dp"
                    tools:ignore="MissingConstraints" />

                <TextView
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:id="@+id/tv_students_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="124+ mentees"
                    android:textSize="14sp"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <!-- Right - Book Now Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:background="@drawable/button_black_rounded"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:id="@+id/btn_book_now"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Book Now"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="6dp" />
            </LinearLayout>

        </LinearLayout>




    </LinearLayout>

</androidx.cardview.widget.CardView>