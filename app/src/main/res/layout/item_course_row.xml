<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="7dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/maroon_100"
    app:strokeColor="@color/line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp">

            <ImageView
                android:id="@+id/ivCourseTile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_course_cover"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvCourseInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_course_cover"
                android:fontFamily="@font/font_display"
                android:gravity="center"
                android:textColor="@color/maroon_700"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="TS" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCourseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/font_display"
                android:maxLines="2"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Trailblazers track" />

            <TextView
                android:id="@+id/tvCourseMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/font_ui"
                android:maxLines="1"
                android:textColor="@color/ink_soft"
                android:textSize="13sp"
                tools:text="with Nelsen Savannah" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLessonsChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_meta_chip"
                    android:fontFamily="@font/font_ui"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/maroon_700"
                    android:textSize="11sp"
                    tools:text="8 lessons" />

                <TextView
                    android:id="@+id/tvDurationChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_meta_chip"
                    android:fontFamily="@font/font_ui"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/maroon_700"
                    android:textSize="11sp"
                    tools:text="3 h" />

                <!-- Kept for binding compatibility -->
                <TextView
                    android:id="@+id/tvCourseStats"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_arrow_right"
            android:rotation="180"
            app:tint="@color/maroon_500"
            tools:ignore="ContentDescription" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
