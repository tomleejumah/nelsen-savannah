<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/layout_media_preview.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Preview Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:background="#000000">

            <!-- Image Preview -->
            <ImageView
                android:id="@+id/previewImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="Image" />

            <!-- Video Preview -->
            <VideoView
                android:id="@+id/previewVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- PDF Preview -->
            <LinearLayout
                android:id="@+id/previewPdf"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFFFFF"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_pdf"
                    android:contentDescription="PDF"
                    app:tint="#E53935" />

                <TextView
                    android:id="@+id/previewPdfName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="24dp"
                    android:text="Document.pdf"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openPdfBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Open PDF"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#E53935"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Play/Pause Button for Video -->
            <ImageButton
                android:id="@+id/playPreview"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/play_button_bg"
                android:src="@drawable/ic_play"
                android:visibility="gone"
                android:contentDescription="Play"
                app:tint="@android:color/white" />

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/closePreview"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:src="@drawable/ic_close"
                android:contentDescription="Close"
                app:tint="@android:color/white" />
        </FrameLayout>

<!--        android:background="@drawable/close_button_bg"-->
        <!-- Description Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESCRIPTION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#999999"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/previewDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Description here"
                android:textSize="14sp"
                android:textColor="#000000"
                android:lineSpacingExtra="4dp"
                android:maxLines="5"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>