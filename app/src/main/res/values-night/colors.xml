<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      MentUI dark overrides. Maroon 900/700/600/500 stay from values/colors.xml.
      Only backgrounds, surfaces, text, lines, and tint chips swap.
    -->

    <color name="bg">#170F12</color>
    <color name="surface">#20161A</color>
    <color name="surface_2">#2B1D21</color>
    <color name="ink">#F4E9EA</color>
    <color name="ink_soft">#D9C4C8</color>
    <color name="muted">#AC8C92</color>
    <color name="line">#3A2429</color>

    <color name="maroon_100">#3A1D25</color>
    <color name="maroon_050">#2B1219</color>

    <color name="tag_blue_bg">#1C2A44</color>
    <color name="tag_blue_text">#9DB6EC</color>
    <color name="status_pending_bg">#3A2C13</color>
    <color name="status_pending_text">#E8B968</color>

    <color name="shadow_maroon">#66000000</color>

    <!-- Semantic aliases follow MentUI dark -->
    <color name="surface_app">@color/bg</color>
    <color name="surface_card">@color/surface</color>
    <color name="surface_muted">@color/surface_2</color>
    <color name="surface_inverse">@color/ink</color>
    <color name="outline_soft">@color/line</color>

    <color name="text_strong">@color/ink</color>
    <color name="text_body">@color/ink_soft</color>
    <color name="text_muted">@color/muted</color>
    <color name="text_on_action">#FFF6F4</color>
    <color name="text_primary">@color/ink</color>
    <color name="text_secondary">@color/ink_soft</color>
    <color name="text_tertiary">@color/muted</color>

    <color name="action_primary">@color/maroon_700</color>
    <color name="action_accent">@color/maroon_500</color>

    <color name="bubble_sent">@color/maroon_700</color>
    <color name="bubble_received">@color/surface_2</color>
    <color name="bubble_quote_bg">#337C1F32</color>

    <color name="blur_overlay">#CC170F12</color>

    <color name="nav_home">@color/maroon_500</color>
    <color name="nav_communities">@color/maroon_600</color>
    <color name="nav_chat">@color/maroon_500</color>
    <color name="nav_profile">@color/maroon_600</color>

    <color name="unread_background">@color/maroon_050</color>
    <color name="background_primary">@color/bg</color>
    <color name="background_secondary">@color/surface</color>
    <color name="card_background">@color/surface</color>
    <color name="progress_background">@color/surface_2</color>
</resources>
