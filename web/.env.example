# LMS API (Nelsen Savannah API on server-remote)
# Local: http://localhost:5002
VITE_LMS_API_BASE=https://api.nelsen-savannah.co.ke

# Firebase project id is immutable and still `nisisi` — do not rename these hosts.
# Same project as Android.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=nisisi.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://nisisi-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=nisisi
VITE_FIREBASE_STORAGE_BUCKET=nisisi.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=209820622367
VITE_FIREBASE_APP_ID=
