# Server
PORT=5002
NODE_ENV=development

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Firebase project id is immutable and still `nisisi` — do not rename these hosts.
FIREBASE_DATABASE_URL=https://nisisi-default-rtdb.firebaseio.com

# LMS primary DB — omit DATABASE_URL to use SQLite at data/lms.sqlite
# DATABASE_URL=postgres://user:pass@localhost:5432/nelsen_lms

# Uploads (bytes in object storage or on disk; metadata rows in DB + RTDB)
UPLOAD_DIR=./uploads
LMS_DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:5002
MEDIA_SIGNING_SECRET=change-me-in-production

# Media storage driver: local (disk, default) | r2 (S3-compatible)
MEDIA_STORAGE_DRIVER=local

# Cloudflare R2 (S3-compatible). Bucket MUST stay private — no public read.
# The same vars point at AWS S3 / Backblaze B2 / MinIO by changing endpoint+region.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# MEDIA_S3_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# MEDIA_S3_REGION=auto
# MEDIA_S3_BUCKET=nelsen-savannah-media
# MEDIA_S3_ACCESS_KEY_ID=r2-access-key-id-placeholder
# MEDIA_S3_SECRET_ACCESS_KEY=r2-secret-access-key-placeholder
# MinIO and some S3 clones need path-style addressing
# MEDIA_S3_FORCE_PATH_STYLE=0

# Presign lifetimes (seconds). Playback TTL must outlast one sit-through of the
# longest lesson; anything longer just extends the life of a leaked link.
MEDIA_PLAYBACK_TTL_SECONDS=3600
MEDIA_UPLOAD_TTL_SECONDS=3600
MEDIA_MAX_UPLOAD_BYTES=2147483648

# Orphan reaper — drops `pending` rows and stale uploads/_tmp files
MEDIA_REAPER_ENABLED=1
MEDIA_REAPER_INTERVAL_MINUTES=60
MEDIA_PENDING_TTL_SECONDS=86400
MEDIA_TMP_TTL_SECONDS=86400
# Delete disk files with no media_assets row (off by default — destructive)
MEDIA_REAPER_PRUNE_ORPHAN_FILES=0

# Set to 1 only to restore the legacy world-readable /uploads mount
MEDIA_PUBLIC_UPLOADS=0

# Desk inquiries (invest / tourism / contact) via Resend
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=Nelsen Savannah <hello@nelsensavanna.co.ke>
# INQUIRY_TO_EMAIL=hello@nelsensavanna.co.ke

# Didit (existing)
# DIDIT_WEBHOOK_SECRET=
# DIDIT_APP_ID=
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
