# Server
PORT=5002
NODE_ENV=development

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_DATABASE_URL=https://nisisi-default-rtdb.firebaseio.com

# LMS primary DB — omit DATABASE_URL to use SQLite at data/lms.sqlite
# DATABASE_URL=postgres://user:pass@localhost:5432/nelsen_lms

# Uploads (lesson media on this host; metadata in DB + RTDB)
UPLOAD_DIR=./uploads
LMS_DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:5002
MEDIA_SIGNING_SECRET=change-me-in-production

# Didit (existing)
# DIDIT_WEBHOOK_SECRET=
# DIDIT_APP_ID=
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
