# Server
PORT=5002
NODE_ENV=development

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Firebase project id is immutable and still `nisisi` — do not rename these hosts.
FIREBASE_DATABASE_URL=https://nisisi-default-rtdb.firebaseio.com

# LMS primary DB — omit DATABASE_URL to use SQLite at data/lms.sqlite
# DATABASE_URL=postgres://user:pass@localhost:5432/nelsen_lms

# Optional Redis catalog cache (no Redis required for correctness).
# Configure local Redis or rediss:// for TLS. Only public catalog bases are
# cached; authenticated enrollment, likes, progress and roles are never cached.
# REDIS_URL=redis://127.0.0.1:6379/0

# Pre-deploy SQLite snapshots and startup integrity/loss checks.
# Restore snapshots with the API stopped; see api/README.md.
LMS_BACKUP_RETENTION=14
# LMS_MIN_TRACKS=0
# LMS_MIN_LESSONS=0
# LMS_MIN_ENROLLMENTS=0
# Emergency ONLY, after investigating a legitimate planned deletion:
# LMS_ALLOW_DATA_DECREASE=1

# Catalog seed is off by default. Set ENABLE to seed an empty DB on boot;
# FORCE wipes + re-seeds (also available via POST /lms/admin/seed).
# LMS_SEED_ENABLE=1
# LMS_SEED_FORCE=1

# Uploads (bytes in object storage or on disk; metadata rows in DB + RTDB)
UPLOAD_DIR=./uploads
LMS_DATA_DIR=./data
PUBLIC_BASE_URL=https://api.nelsen-savannah.co.ke
MEDIA_SIGNING_SECRET=change-me-in-production

# Media storage driver: local (disk, default) | r2 (S3-compatible)
MEDIA_STORAGE_DRIVER=local

# Cloudflare R2 (S3-compatible). Bucket MUST stay private — no public read.
# The same vars point at AWS S3 / Backblaze B2 / MinIO by changing endpoint+region.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# MEDIA_S3_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# MEDIA_S3_REGION=auto
# MEDIA_S3_BUCKET=nelsen-savannah-media
# MEDIA_S3_ACCESS_KEY_ID=r2-access-key-id-placeholder
# MEDIA_S3_SECRET_ACCESS_KEY=r2-secret-access-key-placeholder
# MinIO and some S3 clones need path-style addressing
# MEDIA_S3_FORCE_PATH_STYLE=0

# Presign lifetimes (seconds). Playback TTL must outlast one sit-through of the
# longest lesson; anything longer just extends the life of a leaked link.
MEDIA_PLAYBACK_TTL_SECONDS=3600
MEDIA_UPLOAD_TTL_SECONDS=3600
MEDIA_MAX_UPLOAD_BYTES=2147483648

# Orphan reaper — drops `pending` rows and stale uploads/_tmp files
MEDIA_REAPER_ENABLED=1
MEDIA_REAPER_INTERVAL_MINUTES=60
MEDIA_PENDING_TTL_SECONDS=86400
MEDIA_TMP_TTL_SECONDS=86400
# Delete disk files with no media_assets row (off by default — destructive)
MEDIA_REAPER_PRUNE_ORPHAN_FILES=0

# YouTube Live status sync. The Data API key is server-side only.
# Polling is disabled automatically when YOUTUBE_API_KEY is unset.
# YOUTUBE_API_KEY=your-youtube-data-api-v3-key
YOUTUBE_LIVE_SYNC_ENABLED=1
YOUTUBE_LIVE_SYNC_INTERVAL_SECONDS=60

# YouTube OAuth for creating/managing live broadcasts.
# One Nelsen OAuth client can authorize the platform channel and many school channels.
# YOUTUBE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
# YOUTUBE_OAUTH_CLIENT_SECRET=xxxx
YOUTUBE_OAUTH_REDIRECT_URI=https://api.nelsen-savannah.co.ke/lms/youtube/oauth/callback
# Generate with: openssl rand -hex 32
# YOUTUBE_TOKEN_ENCRYPTION_KEY=64-hex-characters

# Set to 1 only to restore the legacy world-readable /uploads mount
MEDIA_PUBLIC_UPLOADS=0

# Desk inquiries / seat alerts via Resend
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=Nelsen Savannah <info@nelsen-savannah.co.ke>
# INQUIRY_TO_EMAIL=info@nelsen-savannah.co.ke
# RECRUIT_TO_EMAIL=recruit@nelsen-savannah.co.ke

# Didit (existing)
# DIDIT_WEBHOOK_SECRET=
# DIDIT_APP_ID=
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
